# Secrets — never commit. Real keys live in these files.
.env.local
.env.production
.env*.local

# Dependencies / build output
node_modules/
dist/
build/
.next/
*.tsbuildinfo

# Tooling / platform
.vercel/
.DS_Store

# Scratch — one entry, not one per file
scratch/
.budget.json
.ats_cache.json
.budget.json.lock

# Python
__pycache__/
*.pyc
.pytest_cache/

# Vendored reference repo
project-zen/

# Local-only test harness
test_ui.py

.vercel

# Local service runtime (pids, logs, run store)
var/

# Stress corpus names real people; repo is public. Full copies in var/private/.
reference/stress_set.csv
reference/stress_set_pastepack.md
reference/stress_log.jsonl
reference/stress_log.md
perplexity_responses/04_stress_test_prospect_set.md

# The demo seed run store IS tracked -- it ships with the app so a fresh
# deploy has history. Unlike var/, it contains no real people.
!seed/

# Editor backups from the UI revamp -- the real file is the tracked one
*.bak

# Local screenshot captures of the running app (18 MB, not product)
current_prod_snippets/

# Locally installed agent tooling, not part of the product
.claude/
.agents/skills/

# Last observed provider rate-limit statement (local cache, machine-specific)
.ratelimit.json
