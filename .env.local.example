# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
# On Streamlit Community Cloud these go in the app's Secrets panel instead.

# --- Reasoning. Groq is primary; the others are fallbacks. ---
# Free tier is 8,000 tokens/minute -- see the Limits section of README.md.
GROQ_API_KEY=
# Fallback. Free tier is ~20 requests/day/model, so it cannot be primary.
GEMINI_API_KEY=
# Last-resort fallback.
ZAI_API_KEY=

# --- Retrieval ---
EXA_API_KEY=
TAVILY_API_KEY=
APIFY_API_TOKEN=

# --- App ---
# Shared password for the deployed app. Leave unset locally to disable the gate.
APP_PASSWORD=

# --- Optional switches ---
# USE_FIXTURES=1        # replay recorded model calls, make none
# ZARA_LOG_PROMPTS=0    # stop storing prompt text in the run store
# ZARA_RUN_DB=          # override the run store path (default var/zara_runs.db)

# Unlocks the Visual Settings Engine (developer mode) in the Streamlit UI.
# Unset means developer mode never opens. There is deliberately no default.
ZARA_ADMIN_PASSWORD=
